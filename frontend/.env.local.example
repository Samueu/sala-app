# Copie para .env.local e preencha com os valores reais (não commite .env.local).

# URL do backend (backend/README.md). Default se omitido: http://localhost:5289
NEXT_PUBLIC_API_BASE_URL=http://localhost:5289

# Painel do Supabase -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>
